inline constexpr u32 kTypeIdCount = sizeof(kTypeIds) / sizeof(kTypeIds[0]);

inline const char* type_id_name(u32 id) {
    u32 lo = 0, hi = kTypeIdCount;
    while (lo < hi) {
        const u32 mid = (lo + hi) / 2;
        if (kTypeIds[mid].id < id) lo = mid + 1;
        else hi = mid;
    }
    return (lo < kTypeIdCount && kTypeIds[lo].id == id) ? kTypeIds[lo].name : nullptr;
}

