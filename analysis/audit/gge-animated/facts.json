  "class": "0x0106F14B AnimatedIconWin",
  "qi_correction": "7F5500: QI0106F146 returns object itself; QI0105A93D returns +20C; QI010EDF11 returns +210. DF9200 queries 0106F146 THEN uses +20C.",
  "interface_table": {
    "va": "0x014152f4",
    "entries": {
      "0x0": "0x977550",
      "0x4": "0x986260",
      "0x8": "0x7f5a50",
